# Copy this file to `.env` in the project root (and/or `backend/.env`) and
# fill in real values for local development. NEVER commit the real `.env`
# file. No secrets are included here — every value below is a placeholder.

# --- Flask -------------------------------------------------------------------
FLASK_ENV=development
SECRET_KEY=dev-insecure-secret-change-me
JWT_SECRET=dev-insecure-jwt-secret-change-me
JWT_ACCESS_TOKEN_EXPIRES_HOURS=12

# --- Database ------------------------------------------------------------
# Defaults to a local SQLite file under backend/instance/ when unset.
DATABASE_URL=

# --- CORS / frontend origin -----------------------------------------------
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# --- OAuth: Google (leave blank to disable; guest login still works) -------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5050/api/auth/google/callback

# --- OAuth: GitHub (leave blank to disable; guest login still works) -------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:5050/api/auth/github/callback

# --- NASA Open APIs ---------------------------------------------------------
# Keep this key server-side; never put it in frontend/.env or client code.
NASA_API_KEY=DEMO_KEY

# --- Frontend (Vite) ---------------------------------------------------------
# Leave unset in local dev; the Vite dev server proxies /api to localhost:5050.
VITE_API_BASE_URL=/api
